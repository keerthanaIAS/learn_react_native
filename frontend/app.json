{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.anonymous.frontend"
    },
    "web": {
      "favicon": "./assets/images/logo.png"
    },
    "android": {
      "icon": "./assets/images/logo.png",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.frontend"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-maps",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos for this demo.",
          "cameraPermission": "Allow access to the camera for this demo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow access to the camera.",
          "microphonePermission": "Allow microphone access for recording.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow access to your current location."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow access to your device contacts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow microphone access for audio recording."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow access to contacts to display your contacts."
        }
      ],
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "personal-lst"
        }
      ],
      "expo-sharing",
      "@sentry/react-native",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
